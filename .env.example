# llm-redteam-portfolio 统一配置示例
# 复制为 .env 后按需修改；所有脚本均支持「命令行参数 > 环境变量 > 默认值」。

# ---- Ollama（项目 1b / 裁判模型） ----
# Ollama 服务地址（本地默认即可；远程实例改这里）
OLLAMA_BASE_URL=http://localhost:11434
# 被测模型（ollama_runner.py --model 缺省值）
OLLAMA_MODEL=deepseek-r1:7b
# 裁判模型（ollama_judge.py --judge-model 缺省值）
JUDGE_MODEL=qwen2.5:3b

# ---- GGUF 本地推理（项目 1a，llama.cpp） ----
# 模型权重不入库：下载 Qwen2.5-1.5B-Instruct-GGUF (q4_k_m, ~1.1 GB) 后填绝对路径
MODEL_PATH=project1-redteam/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
DATASET_PATH=project1-redteam/prompts/test_set.json
OUTPUT_PATH=project1-redteam/results/raw_results.jsonl

# ---- 中文 PDF 字体（项目 3，可选；缺省自动探测 Windows Fonts） ----
# CJK_FONT_REGULAR=C:\Windows\Fonts\msyh.ttc
# CJK_FONT_BOLD=C:\Windows\Fonts\msyhbd.ttc

# ---- 日志级别 DEBUG/INFO/WARNING ----
LOG_LEVEL=INFO
